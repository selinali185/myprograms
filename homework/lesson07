# rolling 20 sided dice against a set number

# import statement

from random import randrange

# input
DC = int(input("enter your difficulty class: "))

# processing and output

player_roll = randrange(1,21) # never includes b, so it goes up to b exclusively

print(f"player has rolled {player_roll} on their D20. ")

if player_roll >= DC:
    print(f"the player was successful as {player_roll} >= {DC}. ")
else: 
    print(f"the player was successful as {player_roll} < {DC}. ")


#### therefore, randrange(): generates random integer within specified range, instead of range(), selecting in a sequence