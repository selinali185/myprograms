# introduction to iterations 

# While Loop: when we don't know when to end
#ex. 
while condition_variable: 
    user_input = input("Guess the password: ")
    
    if user_input == "poop"
        print("correct guess!")
        condition_variable = False
    else: 
        print("incorrect ")
# end of while loop
print("")


# For Loop: looks at each value in an iterable object and asigns it ot its iterating variable one by one until the end

# ex. 
user_input = input("Search for a fruit: ")

fruits = ['Apple', 'Banana', 'Kiwi', 'Strawberry']
found = False

for fruit_name in fruits: # --> the iterable object
    if fruit_name == user_input:
        print("found!")
        found = True
# end of for loop

if not found: 
    print("not found")
