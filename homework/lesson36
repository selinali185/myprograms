# factors of a number and prime number checker

def factors(num):
    result = []
    for divider in range(1,num + 1):
        if number % divider == 0:
            result.append(divider)
    return factors



def prime_check(num): # check if num is prime
    if len(factors(num)) == 2:
        return True
    else:
        return False
    return len(factors(num))

