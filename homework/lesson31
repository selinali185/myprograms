
def anagram(word1, word2):
    if len(word1) != len(word2):
        return False
    else: # look through all the letters
        list_word1 = sorted(word1)
        list_word2 = sorted(word2)

    for i, character in enumerate(list_word1):
        print(f"i is {i}")
        print(f"character is {character}")
        print(f"list_word2 is {list_word2[i]}")


        if list_word2[i] != character:
            return False
    
    return True


    