# removing duplicates in a list:
# list version
def duplicates(a_list):
    result = []
    for value in a_list:
        if value not in result:
            result.append(value)
    return result 
# set version
def duplicates2(a_list):
    return list(set(a_list))

# unique letters in a given word:
def unique_letters(a_list):
    result = set()
    for word in a_list:
        temp_set = set(word): # removes duplicate characters
        result_set = result_set | (temp_set) # union operator: result.add(temp_set)
        # can also use |= 
    return result_set

test = ["hello", "goodbye", "world"]
print(unique_letters(test))
    
# set intersections: takes list of sets and returns count of elements common to all sets

def i_count(a_list):
    if a_list:
        result_set = a_list[0]
        for example_set in a_list[1:]:
            result_set = result_set & example_set # & is the intersection operator 
        return len(result_set) 

test = [{1,2,3,7}, {3,4,5,7}, {5,6,7,8}]
print(i_count(test))



