# tournament selection
'''
six games; no ties; places players in groups based on 
if player wins 5 or 6 games --> Group 1
if player wins 3 or 4 games --> Group 2
if player wins 1 or 2 games --> Group 3
if player does not win any games --> eliminated
''' 

win_counter = 0
for i in range(6): # --> 0,1,2,3,4,5
        current_result = input(f"Enter the game {i+1} result: ")

        if current_result == "W":
            win_counter += 1
group = 0
if win_counter > 4:
    group = 1
elif win_counter > 2
    group = 2
elif win_counter > 0:
    group = 3

if group == 0:
    print("u eliminated ho")
else: 
    print(f"player placed in {group}. ")
    