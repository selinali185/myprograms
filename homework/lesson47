# constructing: 
# problem: add all numbers from 1 to N; where N is a positive integer

def recursive_sum(num):
    if num == 0: # base case 1 
        return 0
    elif num == 1: # base case 2
        return 1 
    else:
        return num + recursive_sum(num-1)

print(f"sum of all numbers from 1 to 10 is {recursive_sum(10)}")