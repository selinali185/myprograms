# list of prime numbers under N

def factor_list(num):
    result = []
    for divider in range(1,num + 1):
        if number % divider == 0:
            result.append(divider)
    return result

def prime_check(num): # check if num is prime
    return len(factor_list(num)) == 2


def prime_list(upper_limit):
    primes = [2]
    if upper_limit == 2:
        return primes
    else: 
        for num in range(3, upper_limit, 2):
            if prime_check(num):
                primes.append(num)
        return primes


